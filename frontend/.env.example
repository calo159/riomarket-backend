# URL base del backend Django/DRF (sin /api)
VITE_API_URL=http://127.0.0.1:8000
# Muestra los botones de acceso rápido con usuarios de prueba en /login
VITE_DEMO_MODE=true
# Permite elegir el pago sandbox en el checkout (debe coincidir con PAYMENTS_SANDBOX_ENABLED)
VITE_SANDBOX_PAGOS=true
# Tarifa de domicilio usada solo para mostrar el estimado (debe coincidir con DOMICILIO_TARIFA_BASE)
VITE_TARIFA_DOMICILIO=3000
