# Normaliza a LF en el repo: los builds en Linux/Docker y los hooks
# no deben fallar por finales de línea CRLF de Windows.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
