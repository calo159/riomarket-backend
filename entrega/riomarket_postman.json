{
  "info": {
    "name": "RioMarket API",
    "description": "Flujo de prueba de la entrega (login, catálogo, pedido, pago en efectivo y transiciones). Ejecuta las solicitudes en orden; los scripts guardan tokens e IDs en variables de colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "token_vendedor", "value": "" },
    { "key": "id_puesto", "value": "1" },
    { "key": "id_producto", "value": "1" },
    { "key": "id_pedido", "value": "" },
    { "key": "id_pago", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/api/health/", "host": ["{{base_url}}"], "path": ["api", "health", ""] }
      }
    },
    {
      "name": "2. Login comprador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token', data.access);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo\": \"luis@riomarket.test\",\n  \"password\": \"RioMarket2026!\"\n}" },
        "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
      }
    },
    {
      "name": "3. Login vendedor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token_vendedor', data.access);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"correo\": \"carmen@riomarket.test\",\n  \"password\": \"RioMarket2026!\"\n}" },
        "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
      }
    },
    {
      "name": "4. Listar productos del puesto 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const producto = pm.response.json().results[0];",
              "pm.collectionVariables.set('id_puesto', producto.id_puesto);",
              "pm.collectionVariables.set('id_producto', producto.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/api/catalog/productos/?puesto=1&page_size=1", "host": ["{{base_url}}"], "path": ["api", "catalog", "productos", ""], "query": [{ "key": "puesto", "value": "1" }, { "key": "page_size", "value": "1" }] }
      }
    },
    {
      "name": "5. Crear pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('id_pedido', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"id_puesto\": {{id_puesto}},\n  \"tipo_entrega\": \"retiro\",\n  \"items\": [{\"id_producto\": {{id_producto}}, \"cantidad\": 1}]\n}" },
        "url": { "raw": "{{base_url}}/api/orders/pedidos/", "host": ["{{base_url}}"], "path": ["api", "orders", "pedidos", ""] }
      }
    },
    {
      "name": "6. Registrar pago en efectivo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('id_pago', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"pedido\": {{id_pedido}},\n  \"metodo_pago\": \"efectivo\"\n}" },
        "url": { "raw": "{{base_url}}/api/payments/pagos/", "host": ["{{base_url}}"], "path": ["api", "payments", "pagos", ""] }
      }
    },
    {
      "name": "7. Confirmar cobro en efectivo (vendedor)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_vendedor}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{base_url}}/api/payments/pagos/{{id_pago}}/confirmar-efectivo/", "host": ["{{base_url}}"], "path": ["api", "payments", "pagos", "{{id_pago}}", "confirmar-efectivo", ""] }
      }
    },
    {
      "name": "8. Confirmar pedido",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_vendedor}}" }],
        "url": { "raw": "{{base_url}}/api/orders/pedidos/{{id_pedido}}/confirmar/", "host": ["{{base_url}}"], "path": ["api", "orders", "pedidos", "{{id_pedido}}", "confirmar", ""] }
      }
    },
    {
      "name": "9. En preparación",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_vendedor}}" }],
        "url": { "raw": "{{base_url}}/api/orders/pedidos/{{id_pedido}}/en-preparacion/", "host": ["{{base_url}}"], "path": ["api", "orders", "pedidos", "{{id_pedido}}", "en-preparacion", ""] }
      }
    },
    {
      "name": "10. Enviar",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_vendedor}}" }],
        "url": { "raw": "{{base_url}}/api/orders/pedidos/{{id_pedido}}/enviar/", "host": ["{{base_url}}"], "path": ["api", "orders", "pedidos", "{{id_pedido}}", "enviar", ""] }
      }
    },
    {
      "name": "11. Entregar",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/api/orders/pedidos/{{id_pedido}}/entregar/", "host": ["{{base_url}}"], "path": ["api", "orders", "pedidos", "{{id_pedido}}", "entregar", ""] }
      }
    }
  ]
}
