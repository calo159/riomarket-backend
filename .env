DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=BNUJsrecuEoRbUTktMYiG95Zx2d6YVPu2jkhax1c-G6du-xkJlsarjZPkhfI2_N8cx9gMG-lDNKp5FiQGSMiug
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0,testserver

# Clave Fernet (32 bytes en base64url) para cifrar cédulas en reposo.
FERNET_KEY=hTwuEKdKOgwY55s6_DTWes2LVeVJCSYJPYUFMqgyCsc=

# ----------------------------------------------------------------------------
# Base de datos en la nube (Supabase / PostgreSQL, región São Paulo).
# El pooler de Supabase (pgbouncer) requiere CONN_MAX_AGE=0.
# Alternativa local: postgres://riomarket_user:riomarket_pass@localhost:5432/riomarket_db
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres.vhqpyrjtfkorthxxlrxw:Riomarket159852@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
CONN_MAX_AGE=0

# ----------------------------------------------------------------------------
# Redis y Celery (opcionales; en dev sin Redis el entorno cae a modo eager).
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ----------------------------------------------------------------------------
# Pagos (valores de ejemplo para la demo)
# ----------------------------------------------------------------------------
DOMICILIO_TARIFA_BASE=5000.00
PLATFORM_COMMISSION_PERCENTAGE=5.0
PAYMENTS_SANDBOX_ENABLED=True
PAYMENTS_WEBHOOK_SECRET=entrega-rioMarket-webhook-demo
# Alias heredado del proyecto original (no se usa si PAYMENTS_SANDBOX_ENABLED está).
PAYMENT_GATEWAY_SANDBOX=True
