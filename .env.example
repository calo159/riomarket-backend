# =============================================================================
# RioMarket — variables de entorno de referencia.
# Copia este archivo a .env y completa tus valores. El .env NO se versiona (está en .gitignore).
# =============================================================================

# Django
DEBUG=True
SECRET_KEY=change-me-in-production-insecure-secret-key
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,web
# Solo prod (HTTPS reales): CSRF_TRUSTED_ORIGINS=https://riomarket.co,https://admin.riomarket.co

# Base de datos (PostgreSQL)
DATABASE_URL=postgres://riomarket_user:riomarket_pass@localhost:5432/riomarket_db
CONN_MAX_AGE=60

# Redis (solo para la caché compartida de producción; dev/CI usan caché local)
REDIS_URL=redis://localhost:6379/1
LOG_LEVEL=INFO

# CORS (whitelist explícita, nunca "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seguridad / Criptografía
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Obligatoria cuando DEBUG=False (el proyecto no arranca sin ella).
FERNET_KEY=

# Almacenamiento
# MAX_IMAGE_SIZE=2097152
# ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
# PRIVATE_MEDIA_ROOT=C:\ruta\privada\media  (fotos de cédula: jamás pública)

# Paginación y rate limiting
# PAGE_SIZE=20
# THROTTLE_ANON=240/min
# THROTTLE_USER=600/min
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=10/min
# THROTTLE_VERIFICACION=20/min
# THROTTLE_PAGOS=60/min

# Pagos (Fase 4)
# Tarifa base de domicilio en pesos (Decimal; 0 = sin costo de envío).
DOMICILIO_TARIFA_BASE=3000.00
# Comisión de la plataforma en % sobre el subtotal. Se DESCUENTA AL VENDEDOR
# (neto_vendedor = subtotal - comisión); el comprador paga subtotal + domicilio.
PLATFORM_COMMISSION_PERCENTAGE=8.00
# Sandbox: permite simular/auto-aprobar pagos. Debe ser False en producción.
PAYMENTS_SANDBOX_ENABLED=True
# Secreto para verificar la firma de los webhooks de la pasarela real.
# PAYMENTS_WEBHOOK_SECRET=change-me-webhook-secret

# Sesiones JWT (opcionales)
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7

# Para correr los tests contra PostgreSQL en vez de SQLite en memoria
# TEST_DATABASE_URL=postgres://usuario:clave@localhost:5432/riomarket_test

# Seed de arranque (Render): solo carga datos si hay menos de 100 registros.
# SEED_DEMO=true
# SEED_DEMO_PASSWORD=RioMarket2026!

# Notificaciones (Fase 5)
# El email es opcional. Por defecto (False) solo se crean avisos in-app.
# Al activarlo se usa EMAIL_BACKEND (consola en dev, SMTP en prod).
# NOTIFICATIONS_EMAIL_ENABLED=False
# DEFAULT_FROM_EMAIL=no-responder@riomarket.local

# Almacenamiento S3-compatible (Supabase Storage / Cloudflare R2 / AWS) - opcional
# Si se configuran, las imágenes persistirán tras redeploy. Si no, se usa disco local (efímero).
# STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_BUCKET_PUBLICO=productos
# STORAGE_S3_BUCKET_PRIVADO=privado
# STORAGE_S3_BUCKET=productos
# Base pública de los objetos (opcional). Si no termina en el bucket, se añade.
# STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public
# Imágenes demo: scripts/generar_placeholders.py y scripts/buscar_imagenes_libres.py

# Correo de «recuperar contraseña». Render gratis bloquea SMTP, por eso se usa la API HTTP de Brevo
# (brevo.com, plan gratis: 300 correos al día). DEFAULT_FROM_EMAIL debe ser un remitente verificado allí.
# FRONTEND_URL lo entrega Render solo (RENDER_EXTERNAL_URL); en local no hace falta: el correo sale por consola.
# BREVO_API_KEY=
# DEFAULT_FROM_EMAIL=correo-verificado@ejemplo.com
# FRONTEND_URL=https://riomarket-y67g.onrender.com

# Producción (solo si settings=prod)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
