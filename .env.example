# =============================================================================
# RioMarket — ejemplo de variables de entorno (copiar a .env)
# NUNCA subir un .env real al repositorio.
# =============================================================================

# Django
DEBUG=True
SECRET_KEY=change-me-in-production-insecure-secret-key
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,web
# Solo prod (HTTPS reales): CSRF_TRUSTED_ORIGINS=https://riomarket.co,https://admin.riomarket.co

# Base de datos (PostgreSQL)
DATABASE_URL=postgres://riomarket_user:riomarket_pass@localhost:5432/riomarket_db
CONN_MAX_AGE=60

# Redis y Celery (si no hay Redis, poner CELERY_ALWAYS_EAGER=True en dev)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=False
LOG_LEVEL=INFO

# CORS (whitelist explícita, nunca "*")
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seguridad / Criptografía
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Obligatoria cuando DEBUG=False (el proyecto no arranca sin ella).
FERNET_KEY=

# Almacenamiento
# MAX_IMAGE_SIZE=2097152
# ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp
# PRIVATE_MEDIA_ROOT=C:\ruta\privada\media  (fotos de cédula: jamás pública)

# Paginación y rate limiting
# PAGE_SIZE=20
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min
# THROTTLE_LOGIN=10/min
# THROTTLE_REGISTER=10/min
# THROTTLE_PAYMENT=30/min

# Negocio
PLATFORM_COMMISSION_PERCENTAGE=10.0
PAYMENT_GATEWAY_SANDBOX=True

# Producción (solo si settings=prod)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
